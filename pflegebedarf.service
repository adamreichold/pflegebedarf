[Unit]
Description=Pflegebedarf
Wants=network-online.target
After=network-online.target

[Service]
Environment=BIND_ADDR=[::]:80
WorkingDirectory=/var/lib/pflegebedarf

DynamicUser=yes
StateDirectory=pflegebedarf

ExecStart=pflegebedarf
Restart=always

AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
